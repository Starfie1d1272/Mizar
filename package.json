{
  "name": "@mizar/workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.x",
    "pnpm": "12.x"
  },
  "scripts": {
    "fixtures:program:generate": "pnpm --filter @mizar/companion exec tsx test/program-fixtures/generate-real-program-fixtures.ts --write",
    "fixtures:program:verify": "pnpm fixtures:rivals-bp:verify && pnpm --filter @mizar/companion exec tsx test/program-fixtures/generate-real-program-fixtures.ts --check",
    "fixtures:rivals-bp:sync": "pnpm --filter @mizar/rivalhub build && node scripts/fixtures/sync-rivals-bp-program-records.mjs",
    "fixtures:rivals-bp:verify": "pnpm --filter @mizar/rivalhub build && node scripts/fixtures/sync-rivals-bp-program-records.mjs --check",
    "fixtures:replay:generate": "pnpm --filter @mizar/companion exec tsx test/program-fixtures/generate-acceptance-replay.ts --write",
    "fixtures:replay:verify": "pnpm --filter @mizar/companion exec tsx test/program-fixtures/generate-acceptance-replay.ts --check",
    "fixtures:steam:enrich": "node --env-file=.env.local scripts/fixtures/enrich-steam-identities.mjs",
    "architecture:check": "node scripts/architecture/check.mjs",
    "build": "pnpm --recursive --sort --workspace-concurrency=1 run build",
    "cs2-assets:import": "node scripts/cs2-assets/import.mjs",
    "cs2-assets:verify": "node scripts/cs2-assets/verify.mjs",
    "dev": "pnpm --parallel --filter @mizar/companion --filter @mizar/web run dev",
    "format": "prettier --write \"package.json\" \"pnpm-workspace.yaml\" \"tsconfig*.json\" \"eslint.config.js\" \"vitest.config.ts\" \"playwright.acceptance.config.ts\" \".prettierrc.json\" \"apps/**/*.{ts,tsx,js,jsx,json,css,html}\" \"packages/**/*.{ts,tsx,js,jsx,json,css,html}\" \"tests/**/*.{ts,tsx,js,jsx,json,css,html}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"package.json\" \"pnpm-workspace.yaml\" \"tsconfig*.json\" \"eslint.config.js\" \"vitest.config.ts\" \"playwright.acceptance.config.ts\" \".prettierrc.json\" \"apps/**/*.{ts,tsx,js,jsx,json,css,html}\" \"packages/**/*.{ts,tsx,js,jsx,json,css,html}\" \"tests/**/*.{ts,tsx,js,jsx,json,css,html}\" \"scripts/**/*.mjs\"",
    "lint": "pnpm --filter @mizar/cs2-assets build && pnpm --filter @mizar/hud-config build && pnpm --filter @mizar/protocol build && pnpm --filter @mizar/core build && pnpm --filter @mizar/radar build && pnpm --filter @mizar/replay build && pnpm --filter @mizar/rivalhub build && pnpm --filter @mizar/testkit build && pnpm --filter @mizar/telemetry-cstv build && eslint .",
    "test": "pnpm --filter @mizar/hud-config build && pnpm --filter @mizar/protocol build && pnpm --filter @mizar/core build && pnpm --filter @mizar/radar build && pnpm --filter @mizar/replay build && pnpm --filter @mizar/rivalhub build && pnpm --filter @mizar/telemetry-gsi build && pnpm --filter @mizar/telemetry-cstv build && pnpm --filter @mizar/testkit build && vitest run --config vitest.config.ts",
    "typecheck": "pnpm --recursive --sort run typecheck && tsc -p tsconfig.json --noEmit",
    "qualification:build": "node scripts/qualification/build.mjs",
    "qualification:offline": "node scripts/qualification/offline.mjs",
    "qualification:verify": "node scripts/qualification/verify.mjs",
    "local-web:production-smoke": "node scripts/local-web-production-smoke.mjs",
    "cstv:probe": "pnpm --filter @mizar/companion exec tsx src/cstv-probe.ts",
    "testkit:capture:verify": "pnpm --filter @mizar/testkit build && node packages/testkit/dist/cli/verify-capture.js",
    "testkit:capture:sanitize": "pnpm --filter @mizar/testkit build && node packages/testkit/dist/cli/sanitize-capture.js",
    "testkit:capture:replay": "pnpm --filter @mizar/testkit build && node packages/testkit/dist/cli/replay-capture.js",
    "acceptance:test": "pnpm --filter @mizar/cs2-assets build && pnpm --filter @mizar/hud-config build && pnpm --filter @mizar/protocol build && pnpm --filter @mizar/core build && pnpm --filter @mizar/radar build && pnpm --filter @mizar/replay build && pnpm --filter @mizar/rivalhub build && pnpm --filter @mizar/telemetry-gsi build && pnpm --filter @mizar/telemetry-cstv build && pnpm --filter @mizar/testkit build && playwright test --config=playwright.acceptance.config.ts",
    "qualification:objective-timing": "node scripts/qualification/evidence/objective-timing.mjs",
    "fixtures:radar:generate": "pnpm --filter @mizar/companion exec tsx test/program-fixtures/generate-real-radar-fixtures.ts --write",
    "fixtures:radar:verify": "pnpm --filter @mizar/companion exec tsx test/program-fixtures/generate-real-radar-fixtures.ts --check"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
