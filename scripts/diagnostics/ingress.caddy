# Import from /etc/caddy/Caddyfile. The A-only hostname resolves directly to
# 47.103.131.158. Caddy manages its public certificate; never disable upstream TLS.
diagnostics.starfie1d.top {
    request_body {
        max_size 524288
    }
    handle /v1/diagnostics/* {
        reverse_proxy https://diagnostics-origin.starfie1d.top {
            header_up Host diagnostics-origin.starfie1d.top
            header_up X-Mizar-Client-IP {remote_host}
            transport http {
                dial_timeout 5s
                response_header_timeout 25s
            }
        }
    }
    # No administrative interface, access log, body cache or redirect proxy.
    handle {
        respond 404
    }
}
