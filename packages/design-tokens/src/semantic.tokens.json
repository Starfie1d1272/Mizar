{
  "bg": {
    "$type": "color",
    "canvas": {
      "$value": "{color.gray.950}"
    },
    "surface": {
      "$value": "{color.gray.900}"
    },
    "raised": {
      "$value": "{color.gray.850}"
    },
    "hover": {
      "$value": "{color.gray.800}"
    },
    "selected": {
      "$value": "{color.blue.800}"
    }
  },
  "fg": {
    "$type": "color",
    "primary": {
      "$value": "{color.gray.50}"
    },
    "secondary": {
      "$value": "{color.gray.300}"
    },
    "muted": {
      "$value": "{color.gray.400}"
    },
    "on-accent": {
      "$value": "{color.gray.950}"
    }
  },
  "border": {
    "$type": "color",
    "default": {
      "$value": "{color.gray.700}"
    },
    "strong": {
      "$value": "{color.gray.500}"
    }
  },
  "accent": {
    "$type": "color",
    "primary": {
      "$value": "{color.blue.400}"
    },
    "hover": {
      "$value": "{color.blue.300}"
    }
  },
  "status": {
    "$type": "color",
    "success": {
      "$value": "{color.green.400}"
    },
    "warning": {
      "$value": "{color.amber.300}"
    },
    "danger": {
      "$value": "{color.red.300}"
    },
    "info": {
      "$value": "{color.blue.300}"
    }
  },
  "focus": {
    "$type": "color",
    "ring": {
      "$value": "{color.blue.300}"
    }
  },
  "layout": {
    "$type": "dimension",
    "gap": {
      "$value": "{space.12}"
    },
    "padding": {
      "$value": "{space.16}"
    },
    "compact": {
      "$value": "{space.8}"
    },
    "target": {
      "$value": "{size.target}"
    }
  },
  "shape": {
    "$type": "dimension",
    "control": {
      "$value": "{radius.4}"
    },
    "panel": {
      "$value": "{radius.6}"
    },
    "preview": {
      "$value": "{radius.8}"
    }
  },
  "line": {
    "$type": "dimension",
    "border": {
      "$value": "{stroke.thin}"
    },
    "focus": {
      "$value": "{stroke.focus}"
    }
  },
  "type": {
    "family": {
      "$type": "fontFamily",
      "body": {
        "$value": "{font.family.sans}"
      },
      "raw": {
        "$value": "{font.family.mono}"
      },
      "display": {
        "$value": "{font.family.display}"
      }
    },
    "size": {
      "$type": "dimension",
      "body": {
        "$value": "{font.size.14}"
      },
      "small": {
        "$value": "{font.size.12}"
      },
      "title": {
        "$value": "{font.size.20}"
      },
      "readable": {
        "$value": "{font.size.16}"
      },
      "heading": {
        "$value": "{font.size.28}"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "body": {
        "$value": "{font.weight.normal}"
      },
      "strong": {
        "$value": "{font.weight.strong}"
      }
    },
    "line": {
      "$type": "number",
      "body": {
        "$value": "{font.line.normal}"
      }
    }
  },
  "transition": {
    "$type": "duration",
    "fast": {
      "$value": "{motion.duration.fast}"
    },
    "normal": {
      "$value": "{motion.duration.normal}"
    },
    "none": {
      "$value": "{motion.duration.none}"
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": "{motion.easing.standard}"
    }
  },
  "state": {
    "$type": "number",
    "disabled-opacity": {
      "$value": "{opacity.disabled}"
    }
  },
  "brand": {
    "$type": "color",
    "primary": {
      "$value": "{color.brand.cobalt}"
    },
    "front": {
      "$value": "{color.brand.ice}"
    },
    "companion": {
      "$value": "{color.brand.gold}"
    },
    "depth": {
      "$value": "{color.brand.depth}"
    }
  }
}
