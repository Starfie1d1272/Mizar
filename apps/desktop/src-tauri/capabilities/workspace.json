{
  "identifier": "workspace",
  "description": "Packaged loopback product windows may use narrowly scoped desktop commands.",
  "windows": [
    "workspace-left",
    "workspace-dock",
    "program-overlay",
    "main",
    "tool-hud",
    "tool-bp",
    "tool-diagnostics",
    "tool-preview"
  ],
  "remote": {
    "urls": ["http://127.0.0.1:3000/*"]
  },
  "permissions": [
    "allow-restore-layout",
    "allow-restore-cs2-focus",
    "allow-set-program-overlay-enabled",
    "allow-cs2-host-status",
    "allow-select-obs-executable",
    "allow-open-main",
    "allow-present-production",
    "allow-open-tool",
    "allow-open-rivalhub-authorization",
    "allow-open-rivalhub-workbench",
    "allow-save-support-bundle",
    "allow-gsi-status",
    "allow-configure-gsi"
  ]
}
