{
  "identifier": "workspace",
  "description": "Packaged loopback product windows may use narrowly scoped desktop commands.",
  "windows": [
    "workspace-left",
    "workspace-dock",
    "program-overlay",
    "main",
    "tool-hud",
    "tool-bp",
    "tool-diagnostics",
    "tool-preview",
    "tool-review"
  ],
  "remote": {
    "urls": ["http://127.0.0.1:3000/*"]
  },
  "permissions": [
    "allow-restore-layout",
    "allow-recover-program-overlay",
    "allow-program-overlay-ready",
    "allow-restore-cs2-focus",
    "allow-set-program-overlay-enabled",
    "allow-cs2-host-status",
    "allow-select-obs-executable",
    "allow-launch-obs",
    "allow-cs2-config-status",
    "allow-mulnx-handoff-status",
    "allow-open-mulnx-browser",
    "allow-launch-mulnx",
    "allow-observer-command",
    "allow-start-managed-cs2",
    "allow-begin-managed-camera",
    "allow-cancel-managed-camera",
    "allow-finish-managed-cs2",
    "allow-workspace-exit-status",
    "allow-restore-cs2-backup",
    "allow-open-cs2-backup",
    "allow-set-cs2-preferences",
    "allow-open-main",
    "allow-present-production",
    "allow-open-tool",
    "allow-open-rivalhub-authorization",
    "allow-open-rivalhub-workbench",
    "allow-open-steam-api-key",
    "allow-open-issue-report",
    "allow-install-update",
    "allow-open-update-page",
    "allow-open-music-downloads",
    "allow-open-update-recovery",
    "allow-save-support-bundle",
    "allow-gsi-status",
    "allow-ensure-gsi",
    "allow-configure-gsi",
    "allow-select-cs2-installation",
    "allow-open-cs2-config-directory"
  ]
}
