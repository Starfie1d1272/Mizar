{
  "identifier": "workspace",
  "description": "Only the packaged local Companion pages in the three desktop windows may use native window controls.",
  "windows": ["workspace-left", "workspace-dock", "program-overlay"],
  "remote": { "urls": ["http://127.0.0.1:3000/*"] },
  "permissions": [
    "allow-restore-layout",
    "allow-restore-cs2-focus",
    "allow-set-program-overlay-enabled",
    "allow-cs2-host-status",
    "allow-select-obs-executable"
  ]
}
