{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mizar-diagnostics",
  "account_id": "754634a82d628d202a3da6771b5fb348",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "r2_buckets": [{ "binding": "DIAGNOSTICS_BUCKET", "bucket_name": "mizar-telemetry" }],
  "d1_databases": [{ "binding": "DIAGNOSTICS_DB", "database_name": "mizar-telemetry", "database_id": "e85505ac-5388-471c-abbe-7a4d9e15bde7", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "ENROLL_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "UPLOAD_LIMITER", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ],
  "vars": {
    "ACCEPTING": "0",
    "DATABASE_BYTES": "0",
    "DAILY_BYTES": "0", "DAILY_BATCHES": "0", "DAILY_REGISTRATIONS": "0",
    "INSTALLATION_DAILY_BYTES": "0", "INSTALLATION_DAILY_BATCHES": "0"
  },
  "triggers": { "crons": ["*/15 * * * *"] }
}
